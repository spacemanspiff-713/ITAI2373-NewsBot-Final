# Optional runtime configuration. Never commit a real .env file.
NEWSBOT_SECRET_KEY=replace-with-a-local-secret
NEWSBOT_TRANSLATION_BACKEND=auto
# Set to 1 only when Hugging Face model downloads are permitted.
NEWSBOT_ENABLE_TRANSFORMERS=0
# Set to 1 after models have been cached for an offline run.
NEWSBOT_TRANSFORMERS_LOCAL_ONLY=0
NEWSBOT_MAX_BATCH_SIZE=20
NEWSBOT_LOG_LEVEL=INFO
